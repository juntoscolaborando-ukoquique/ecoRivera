# =============================================================
# .env.example — Nodo Agroecológico Minas de Corrales
# Copiá este archivo como .env y completá los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =============================================================


# -------------------------------------------------------------
# FORMULARIO DE CONTACTO — Formspree (https://formspree.io/)
# Creá una cuenta gratuita, creá un formulario y copiá el endpoint.
# Reemplazá también el valor FORMSPREE_ENDPOINT en main.js.
# -------------------------------------------------------------

FORMSPREE_ENDPOINT=https://formspree.io/f/XXXXXXXX


# -------------------------------------------------------------
# INFORMACIÓN DE CONTACTO DIRECTO (visible en el footer)
# -------------------------------------------------------------

CONTACT_WHATSAPP=+598XXXXXXXXX
CONTACT_EMAIL=tu@email.com


# -------------------------------------------------------------
# METADATOS DEL SITIO (SEO y Open Graph)
# Actualizá SITE_URL cuando tengas una URL definitiva.
# OG_IMAGE_URL usa la foto de Wikimedia por defecto, podés
# reemplazarla con una imagen propia subida al repositorio.
# -------------------------------------------------------------

SITE_URL=https://tu-usuario.github.io/nombre-repo
OG_IMAGE_URL=https://upload.wikimedia.org/wikipedia/commons/9/9e/Valle_del_Lunarejo.JPG


# -------------------------------------------------------------
# REDES SOCIALES (usadas en el footer)
# -------------------------------------------------------------

SOCIAL_FACEBOOK=https://facebook.com/tu-pagina
SOCIAL_INSTAGRAM=https://instagram.com/tu-perfil


# -------------------------------------------------------------
# GITHUB (opcional — enlace al código fuente en el footer)
# -------------------------------------------------------------

GITHUB_REPO=https://github.com/tu-usuario/nombre-repo
